+# Keep producer statuses separate: a failed query is not an empty topology.
+hash_state() (
+    umask 077
+    SNAPSHOT=$(mktemp /tmp/8311-topology.XXXXXX) || exit 1
+    trap 'rm -f "$SNAPSHOT"' 0
+    trap 'exit 1' HUP INT TERM
+    ip li > "$SNAPSHOT" || exit 1
+    brctl show >> "$SNAPSHOT" || exit 1
+    for BRPORT_STATE in /sys/devices/virtual/net/sw*/lower_*/brport/state; do
+        # No bridge ports is a valid state; an existing unreadable port is not.
+        [ -e "$BRPORT_STATE" ] || continue
+        VALUE=$(cat "$BRPORT_STATE") || exit 1
+        printf '%s: %s\n' "$BRPORT_STATE" "$VALUE" >> "$SNAPSHOT" || exit 1
+    done
+    HASH=$(sha256sum < "$SNAPSHOT") || exit 1
+    DIGEST=${HASH%% *}
+    case "$DIGEST" in ''|*[!0-9a-f]*) exit 1 ;; esac
+    [ "${#DIGEST}" -eq 64 ] || exit 1
+    case "$HASH" in "$DIGEST  -"|"$DIGEST *-") ;; *) exit 1 ;; esac
+    printf '%s\n' "$DIGEST"
+)
+
+STATE_HASH=$(hash_state) || exit 1
 if [ "$HASH_ONLY" -eq 1 ]; then
     echo "$STATE_HASH"
     exit 0
